# secrets
.env
.env.*
!.env.example

# data (regenerable via src/s*.py scripts)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# sandbox dashboard event history (local UI test data, not a deliverable — regenerable
# by using the tool; see sandbox/events_store.py). Never contains real training data —
# see Phase 3 in experiments/log.md for the separation-from-training-data check.
sandbox/data/manual_events.csv
sandbox/data/events/*.jsonl

# sandbox Phase 5 experiment persistence (local SQLite, regenerable via the Experiments page)
sandbox/experiments.db

# sector news collection — RAW article text must never reach git (repo is public, several
# sources' ToS forbid redistribution regardless of local-use legality) — only derived
# metadata (sandbox/data/sector_news_processed/) is committed. See DECISIONS_NEEDED.md.
sandbox/data/sector_news_raw/

# OS / editor
.DS_Store
__pycache__/
*.pyc
.ipynb_checkpoints/
